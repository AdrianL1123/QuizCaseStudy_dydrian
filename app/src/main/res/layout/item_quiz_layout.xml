<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcvQuiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="@color/lightGray"
    app:cardCornerRadius="@dimen/m"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/m">

        <!--    Quiz ID    -->
        <TextView
            android:id="@+id/tvQuizId"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz ID: "
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Title of the Quiz -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz Title"
            android:textStyle="bold" />

        <!-- Time per Question -->
        <TextView
            android:id="@+id/tvTimePerQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time per Question: 30 seconds" />

        <!-- Number of Questions -->
        <TextView
            android:id="@+id/tvNumberOfQuestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Questions: 5" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>